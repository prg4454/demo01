# Server Port
PORT=5000
NODE_ENV=development

# Database Configuration
# Supported dialects: sqlite, postgres, mysql
DB_DIALECT=sqlite
DB_STORAGE=./database.sqlite

# For Postgres / MySQL (uncomment and configure if using):
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=demo01_db
# DB_USER=postgres
# DB_PASSWORD=your_password
